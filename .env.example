# Imagen local para construir desde código; la distribución pública usa ghcr.io/ezr43l/base-documental-s:0.4.2.
RTFM_IMAGE=rtfm:0.4.2
RTFM_BUILD_VERSION=0.4.2
RTFM_SOURCE_URL=https://github.com/Ezr43l/base-documental-s
RTFM_LICENSE_SPDX=Apache-2.0
RTFM_CONTAINER_NAME=rtfm
RTFM_ENV_FILE=.env
RTFM_SECRETS_PATH=./local-data/secrets

# Runtime
PORT=7400
NODE_NAME=node-a
ROLE_MODE=auto
PUBLIC_SCHEME=http
# IPs o redes de los reverse proxies que realmente conectan con RTFM. Nunca uses *.
FORWARDED_ALLOW_IPS=127.0.0.1

# Keepalived / floating IP. Use the same service and claim ID on every replica.
KEEPALIVED_API_URL=http://127.0.0.1:6060
KEEPALIVED_API_KEY=
KEEPALIVED_API_KEY_FILE=
KEEPALIVED_SERVICE=rtfm
KEEPALIVED_DESCRIPTION=RTFM
# Obligatorio y compartido por los nodos si se usa Keepalived; debe ser único por instalación.
KEEPALIVED_CLAIM_ID=
KEEPALIVED_HEALTH_PATH=/api/health
KEEPALIVED_SERVICE_PORTS=
KEEPALIVED_TIMEOUT_SECONDS=5
KEEPALIVED_ALLOW_INSECURE_HTTP=false
KEEPALIVED_CA_FILE=

# Optional manual fallback / canonical URL
FLOATING_IP=
FLOATING_URL=

# Authentication. Generate independent random values; do not commit .env.
APP_TOKEN=
APP_TOKEN_FILE=
SESSION_SECRET=
SESSION_SECRET_FILE=
SESSION_HOURS=12
SESSION_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
PASSWORD_MIN_LENGTH=12
TOTP_ISSUER=RTFM

# Replication. Add any number of peers and omit this node.
REPLICATION_TOKEN=
REPLICATION_TOKEN_FILE=
REPLICATION_ALLOW_INSECURE_HTTP=false
REPLICATION_CA_FILE=
MAX_REPLICATION_MB=512
# Ejemplo: node-b=https://node-b.example:7400,node-c=https://node-c.example:7400
PEERS=
SYNC_INTERVAL_SECONDS=300

# Data policy and Git projection
RETENTION_DAYS=90
MAX_IMAGE_SIZE_MB=10
GIT_ENABLED=true
GIT_REPO_DIR=/data/git
GIT_AUTHOR_NAME=RTFM
GIT_AUTHOR_EMAIL=rtfm@localhost
